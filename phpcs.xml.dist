<?xml version="1.0"?>
<ruleset name="MySQLite">
    <description>PSR-12, except that SQL function methods are named mysql_[function].</description>

    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>src/Vectorface/MySQLite/MySQL/*</exclude-pattern>
        <exclude-pattern>tests/Vectorface/Tests/MySQLite/Util/CustomMySQLite.php</exclude-pattern>
    </rule>
</ruleset>
